# PanDA Compose — environment variable template
# Copy to .env and fill in secrets before running `docker compose up`.
# Variable names mirror those used in panda-k8s/secrets/templates/.

# ──────────────────────────────────────────────
# PostgreSQL (PanDA server + JEDI)
# ──────────────────────────────────────────────
PANDA_DB_BACKEND=postgres
PANDA_DB_HOST=postgres
PANDA_DB_PORT=5432
PANDA_DB_USER=panda
PANDA_DB_PASSWORD=panda_secret
PANDA_DB_NAME=panda_db

# Schema names (must match the values baked into the panda-database image init scripts)
PANDA_DB_SCHEMAPANDA=DOMA_PANDA
PANDA_DB_SCHEMAMETA=DOMA_PANDAMETA
PANDA_DB_SCHEMAPANDAARCH=DOMA_PANDAARCH
PANDA_DB_SCHEMAJEDI=DOMA_PANDA
PANDA_DB_SCHEMADEFT=DOMA_DEFT

# ──────────────────────────────────────────────
# ActiveMQ
# ──────────────────────────────────────────────
PANDA_ACTIVEMQ_LIST=activemq:61613
PANDA_ACTIVEMQ_PASSWD_panda=panda_mq_secret
PANDA_ACTIVEMQ_PASSWD_jedi=jedi_mq_secret

# ──────────────────────────────────────────────
# PanDA server
# ──────────────────────────────────────────────
# Internal service URL used by Harvester and panda-client.
PANDA_URL=http://panda-server:80/server/panda
PANDA_URL_SSL=https://panda-server:443/server/panda
PANDA_VERIFY_HOST=off
PANDA_BEHIND_REAL_LB=1

# Authentication: set to "oidc" for token-based or leave "None" for x509/no-auth dev mode
PANDA_AUTH=None

# ──────────────────────────────────────────────
# Compute queues
# ──────────────────────────────────────────────
# Whitespace- or comma-separated list of local compute queue names to register.
# Each queue is created in the PanDA schedconfig (setup-queue.sh) and managed by
# the harvester (rendered into panda_queues.cfg). Defaults to the single built-in
# queue; add more to fan work out to additional sites, e.g.:
#   PANDA_QUEUES=PANDA_COMPOSE_LOCAL E1_BNL E1_JLAB
PANDA_QUEUES=PANDA_COMPOSE_LOCAL

# ──────────────────────────────────────────────
# JEDI task submission
# ──────────────────────────────────────────────
# VO and prodSourceLabel that JEDI *tasks* are submitted under (the prun /
# panda_api.submit_task path; direct pandajob-submit jobs ignore these). They
# must match the [taskrefine] procConfig in config/panda/panda_jedi.cfg, and
# they select the JEDI work-queue / global-share rows seeded by setup-queue.sh.
PANDA_TASK_VO=epic
PANDA_TASK_LABEL=test
# How often (seconds) the jedi-aux-refresh sidecar calls
# jedi_refr_mintaskids_bystatus() so JEDI tasks don't stall between status
# transitions. Lower = snappier task progress, higher = less DB chatter.
JEDI_AUX_REFRESH_INTERVAL=15

# ──────────────────────────────────────────────
# Harvester
# ──────────────────────────────────────────────
HARVESTER_EXPERIMENT=wlcg

# ──────────────────────────────────────────────
# Optional HTTP/S proxy (leave blank if not needed)
# ──────────────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
